# CSC site values for the §11 E-B amendment-2 remote host (yi:9b on CSC Puhti).
# Copy to configs/csc/site.env and fill in locally / on the cluster.
# site.env is GITIGNORED: no account string, project number, or scratch
# path may ever enter version control (public-bound repo).
CSC_ACCOUNT=<csc-project-id>
CSC_SCRATCH=<scratch-project-dir>/behavioral-trilemma
