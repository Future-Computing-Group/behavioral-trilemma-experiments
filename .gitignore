__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store
.progress.json
results/*.csv
analysis/figures/*.png
analysis/figures/*.pdf
notes/
.env

# Experiment data must not be tracked (L73 — no internal data in git).
# Pattern note: `experiment_output/**/*.csv` did NOT actually catch
# nested CSVs under `experiment_output/logprob_xmodel/*/*.csv` on some git
# versions, so we add the explicit subtree rule too. Run
# `git check-ignore -v <path>` to verify before assuming a path is ignored.
experiment_output/**/*.csv
experiment_output/**/*.csv.orig
experiment_output/**/*.json
experiment_output/**/*.jsonl
experiment_output/logprob_xmodel/
experiment_output/raw_runs/
experiment_output/analysis_logprob/
experiment_output/competence_probe/_runs/
# Re-permit the canonical results JSON (manuscript Table 1) + the H3 figure
# + the cross-model figure + the competence-probe figure, all of which are
# load-bearing for the artefact reviewers will inspect.
!experiment_output/analysis/hypothesis_results.json
# §11 E-A canonical sibling artifacts (amendment 1): the V_c rank-aligned-limit
# JSON, the rearrangement robustness JSON, and the E-A.2 violation rates are
# load-bearing analysis artifacts (per-config CSVs under raw_runs/ stay ignored).
!experiment_output/analysis/hypothesis_results-comonotone.json
!experiment_output/analysis/hypothesis_results-rearrangement.json
!experiment_output/analysis/comonotone_violation.json
!experiment_output/analysis/figures/h3_convexity_by_N.pdf
!experiment_output/analysis/figures/h3_convexity_by_N.png
!experiment_output/competence_probe/figures/
!experiment_output/competence_probe/figures/*

# Local campaign ops log (gitignored — internal, L51/L73)
OPSLOG.md

# Agent / superpowers workflow artifacts are internal (L73 recurrence 2026-05-21)
docs/superpowers/
**/plans/

# Generated experiment artifacts — not tracked. The published figures
# (analysis/figures/h3_convexity_by_N.*, competence_probe/figures/model_points.*)
# are already tracked and stay tracked; .gitignore does not untrack them.
experiment_output/**/*.pdf
experiment_output/**/*.png
experiment_output/**/*.zip
experiment_output/**/*.partial
experiment_output/**/*.log
experiment_output/**/_*COMPLETE
# Vestigial frozen code snapshots under the output dir (never import these;
# the maintained package is repo-root analysis/) — must not be tracked
experiment_output/**/*.py
